# Copy to .env and fill in. .env is gitignored — never commit real values.

# Discord bot token from https://discord.com/developers/applications
# The bot also needs the SERVER MEMBERS INTENT enabled under Bot -> Privileged Gateway Intents,
# otherwise it cannot enumerate role members and will fail to connect.
BOT_TOKEN=your-discord-bot-token-here

POSTGRES_DB=albionbot
POSTGRES_USER=albionbot
POSTGRES_PASSWORD=change-me
